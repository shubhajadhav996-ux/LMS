# Copy this file to .env and fill in real values. .env is git-ignored.
BASE_URL=https://lms-website-lyart.vercel.app
API_URL=https://lms-backend-gamma-six.vercel.app/api/v1

TRAINER_EMAIL=your-trainer-email@example.com
TRAINER_PASSWORD=your-password

# The portal sends trainers back to /trainer/profile until their profile is 100% complete.
# true  = tests make the browser believe the profile is complete (nothing is changed on the account),
#         so the course / announcement / task pages can be tested.
# false = test the real behaviour (all page tests will fail until the trainer profile is complete).
BYPASS_PROFILE_GATE=true

# true = run tests that CREATE data (batch, document, announcement, task). Everything they create
#        is named "QA Test ...". Nothing is ever deleted.
RUN_CREATE_TESTS=true
